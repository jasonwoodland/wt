#!/usr/bin/env bash
set -eo pipefail

WT_SOURCE=${BASH_SOURCE[0]}
while [ -L "$WT_SOURCE" ]; do
  WT_SOURCE_DIR=$(cd "$(dirname "$WT_SOURCE")" && pwd)
  WT_SOURCE=$(readlink "$WT_SOURCE")
  [[ "$WT_SOURCE" == /* ]] || WT_SOURCE="$WT_SOURCE_DIR/$WT_SOURCE"
done
WT_LIB_DIR="$(cd "$(dirname "$WT_SOURCE")" && pwd)/lib"
source "$WT_LIB_DIR/github.bash"
source "$WT_LIB_DIR/hyperlinks.sh"

usage() {
  cat <<'EOF'
Usage: wt [options] [<branch> | <substring> | <path>]
       wt .
       wt -M [<oldbranch>] <newbranch>

Switch between Git worktrees. With no arguments, open an fzf picker, or list
worktrees and local branches when fzf is unavailable.

Arguments:
  <branch>                  Switch to the branch's worktree, creating it if needed.
  <substring>               Match a local branch or existing worktree directory name.
  <pr-number>               Switch to a PR's linked-issue worktree or local branch.
  <path>                    Switch to a registered worktree by absolute path.
  .                         Switch to the repo root that owns .worktrees.

Options:
  -a, --all                 With --clean, include all clean worktrees.
                            Skip merge and ahead safeguards.
  -b, --branch <branch>      Create a branch from the root HEAD and switch to it.
  -c, --clean [<target>]     Remove eligible merged worktrees after confirmation.
                            Optionally select one by branch, substring, or path.
  -d, --delete <branch>      Remove the clean worktree, then delete the branch
                            if Git considers it fully merged.
  -f, --force                With --clean, skip confirmation.
  -h, --help                 Show this help.
  -i, --interactive         With --clean, select worktrees using fzf multi-select.
  -l, --latest               Switch to the latest local branch by committer date.
  -M, --move [<old>] <new>    Rename a branch and move its worktree, if one exists.
                            <old> defaults to the current branch.
      --zsh-completion      Print the zsh completion definition.

Exact branches take priority. Otherwise, a literal, case-sensitive substring
must match exactly one branch or worktree; multiple matches are listed as an error.

Cleanup skips worktrees ahead of upstream and requires a merge into root HEAD
or a merged PR matching HEAD. --all skips these checks.
Dirty worktrees and root are always protected. Combine -c, -f, -a, and -i as needed.

Examples:
  wt feature/login          Switch to an existing branch's worktree.
  wt 123                    Switch to the worktree matching issue number 123.
  wt login                  Switch to the worktree matching login.
  wt -b feature/search      Create a branch and switch to its worktree.
  wt -M feature/find        Rename the current branch and move its worktree.
  wt -c                     Remove eligible merged worktrees after confirmation.
  wt -cf                    Do the same without confirmation.
  wt -cf 320                Clean matching worktree if it passes safeguards.
  wt -ca                    Remove all clean worktrees after confirmation.
  wt -cfa                   Remove all clean worktrees without confirmation.
  wt -ci                    Pick eligible worktrees to clean with fzf.
  wt -ciaf                  Pick from all clean worktrees; skip confirmation.
  wt -c --all login         Remove matching clean worktree after confirmation.

The zsh function changes the current shell directory. When called directly,
the executable prints the destination path for navigation commands.
EOF
}

find_worktrees_root() {
  local start_dir="${1:-${WT_CWD:-$PWD}}"
  local dir="$start_dir"
  local git_root main_worktree

  while [ "$dir" != "/" ]; do
    if [ -d "$dir/.worktrees" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done

  main_worktree=$(git -C "$start_dir" worktree list --porcelain 2>/dev/null | awk '/^worktree / { print substr($0, 10); exit }' || true)
  if [ -n "$main_worktree" ]; then
    printf '%s\n' "$main_worktree"
    return 0
  fi

  git_root=$(git -C "$start_dir" rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$git_root" ]; then
    printf '%s\n' "$git_root"
    return 0
  fi

  return 1
}

list_contains() {
  local needle="$1"
  local haystack="$2"

  [ -n "$haystack" ] || return 1
  printf '%s\n' "$haystack" | grep -Fxq -- "$needle"
}

root_branch() {
  git branch --show-current 2>/dev/null || true
}

is_existing_worktree_path() {
  local path="$1"

  [ -n "$path" ] || return 1
  [ -d "$path" ] || return 1
  git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

worktree_branch_rows() {
  local include_detached=0
  [ "${1:-}" != --include-detached ] || include_detached=1
  git worktree list --porcelain 2>/dev/null |
    awk -v include_detached="$include_detached" '
      function flush() {
        if (path != "" && branch != "") {
          print branch "\t" path "\t" head
        } else if (path != "" && detached && include_detached) {
          print path "\t" path "\t" head "\tdetached"
        }
        detached = 0
        path = ""
        branch = ""
        head = ""
      }
      /^worktree / {
        flush()
        path = substr($0, 10)
        branch = ""
        head = ""
        next
      }
      /^HEAD / {
        head = substr($0, 6)
        next
      }
      /^branch refs\/heads\// {
        branch = substr($0, 19)
        next
      }
      /^detached$/ { detached = 1 }
      /^$/ { flush() }
      END { flush() }
    '
}

branch_ref_rows() {
  local sort_value
  local -a sort_args

  for sort_value in "$@"; do
    [ -n "$sort_value" ] || continue
    sort_args+=(--sort="$sort_value")
  done

  git for-each-ref "${sort_args[@]}" --format='%(refname:short)%09%(objectname:short=7)%09%(upstream)%09%(upstream:track)' refs/heads/ 2>/dev/null
}

latest_branch() {
  local root branch

  root=$(find_worktrees_root) || {
    echo "Could not find .worktrees directory or Git repository root." >&2
    return 1
  }
  root=$(cd "$root" && pwd -P)

  cd "$root"
  branch=$(git for-each-ref --sort=-committerdate --count=1 --format='%(refname:short)' refs/heads 2>/dev/null || true)
  if [ -z "$branch" ]; then
    echo "No local branches found." >&2
    return 1
  fi

  printf '%s\n' "$branch"
}

create_branch() {
  local branch="$1" root

  root=$(find_worktrees_root) || return $?
  root=$(cd "$root" && pwd -P)
  cd "$root"

  git branch "$branch" >&2
  resolve_path "$branch"
}

move_branch() {
  local old_branch="${1:-}" new_branch="${2:-}" root root_physical old_path new_path has_worktree

  if [ -z "$new_branch" ]; then
    echo "Usage: wt --move [<oldbranch>] <newbranch>" >&2
    return 2
  fi

  root=$(find_worktrees_root) || {
    echo "Could not find .worktrees directory or Git repository root." >&2
    return 1
  }
  root_physical=$(cd "$root" && pwd -P)

  # Default old branch to HEAD (use user's original cwd, not root)
  if [ -z "$old_branch" ]; then
    if [ -n "${WT_CWD:-}" ]; then
      old_branch=$(git -C "$WT_CWD" branch --show-current 2>/dev/null || true)
    else
      old_branch=$(git branch --show-current 2>/dev/null || true)
    fi
    if [ -z "$old_branch" ]; then
      echo "Not on a branch and no <oldbranch> given." >&2
      return 1
    fi
  fi

  cd "$root_physical"

  # Validate old branch exists
  if ! git show-ref --verify --quiet "refs/heads/$old_branch"; then
    echo "Branch '$old_branch' does not exist." >&2
    return 1
  fi

  # Validate new branch does not exist
  if git show-ref --verify --quiet "refs/heads/$new_branch"; then
    echo "Branch '$new_branch' already exists." >&2
    return 1
  fi

  # Check if a linked worktree exists (use git's stored path for the check)
  old_path=$(worktree_path_for_branch "$old_branch")
  has_worktree=0
  if [ -n "$old_path" ] && [ "$old_path" != "$root_physical" ]; then
    has_worktree=1
  fi

  # Rename the branch
  echo "Renaming branch '$old_branch' to '$new_branch'..." >&2
  git branch -m "$old_branch" "$new_branch" >&2 || return $?

  if [ "$has_worktree" = 1 ]; then
    # Use git's stored paths for git worktree move (canonical),
    # but output logical paths for the zsh function
    new_git_path="${old_path%/*}/$new_branch"
    echo "Moving worktree to '$new_git_path'..." >&2
    if ! git worktree move "$old_path" "$new_git_path" >&2; then
      # Rollback: rename the branch back
      echo "Worktree move failed, rolling back branch rename..." >&2
      git branch -m "$new_branch" "$old_branch" >&2 || true
      return 1
    fi
    # Output logical paths (from find_worktrees_root) for zsh cd comparison
    printf '%s\n' "$root/.worktrees/$old_branch"
    printf '%s\n' "$root/.worktrees/$new_branch"
  fi
}

delete_branch() {
  local branch="$1" root worktree_path

  if [ -z "$branch" ]; then
    echo "Usage: wt --delete <branch>" >&2
    return 2
  fi

  root=$(find_worktrees_root) || {
    echo "Could not find .worktrees directory or Git repository root." >&2
    return 1
  }
  root=$(cd "$root" && pwd -P)
  cd "$root"

  worktree_path=$(worktree_path_for_branch "$branch")
  if [ -z "$worktree_path" ]; then
    echo "No worktree found for branch '$branch'." >&2
    return 1
  fi

  local worktree_abs
  worktree_abs=$(cd "$worktree_path" && pwd -P 2>/dev/null || true)
  if [ "$worktree_abs" = "$root" ]; then
    echo "Cannot delete root worktree." >&2
    return 1
  fi

  echo "Removing worktree for '$branch'..." >&2
  git worktree remove "$worktree_path" >&2 || return $?

  echo "Deleting branch '$branch'..." >&2
  git branch -d "$branch" >&2 || return $?

  printf 'Deleted branch '\''%s'\'' and removed worktree.\n' "$branch" >&2
}

resolve_latest_path() {
  local branch

  branch=$(latest_branch) || return $?
  resolve_path "$branch"
}

latest_usage_error() {
  usage >&2
  return 2
}

is_latest_mixed_short_option_token() {
  local arg="${1:-}"

  case "$arg" in
    -|--*|-l)
      return 1
      ;;
    -*l*)
      return 0
      ;;
  esac

  return 1
}

branch_usage_error() {
  usage >&2
  return 2
}

worktree_path_for_branch() {
  local target="$1" branch path sha

  while IFS=$'\t' read -r branch path sha; do
    [ "$branch" = "$target" ] || continue
    is_existing_worktree_path "$path" || continue
    printf '%s\n' "$path"
    return 0
  done < <(worktree_branch_rows)

  return 0
}

worktree_rows() {
  git worktree list --porcelain 2>/dev/null |
    awk '
      function short_sha(value) {
        return substr(value, 1, 7)
      }
      function flush() {
        if (path != "") {
          print path "\t" branch "\t" short_sha(head)
        }
        path = ""
        branch = ""
        head = ""
      }
      /^worktree / {
        flush()
        path = substr($0, 10)
        branch = ""
        head = ""
        next
      }
      /^HEAD / {
        head = substr($0, 6)
        next
      }
      /^branch refs\/heads\// {
        branch = substr($0, 19)
        next
      }
      /^$/ { flush() }
      END { flush() }
    '
}

relative_path_for_root() {
  local path="$1" root="$2" rel=""
  local -a path_parts root_parts
  local i j

  if [ -z "$path" ]; then
    printf '\n'
    return 0
  fi
  if [ -n "$root" ] && [ "$path" = "$root" ]; then
    printf '.\n'
    return 0
  fi
  if [ -n "$root" ] && [ "$root" != "/" ] && [[ "$path" == "$root"/* ]]; then
    printf '%s\n' "${path#$root/}"
    return 0
  fi
  if [ "$root" = "/" ] && [[ "$path" == /* ]]; then
    printf '%s\n' "${path#/}"
    return 0
  fi
  if [ -n "$root" ] && [[ "$path" == /* ]] && [[ "$root" == /* ]]; then
    IFS=/ read -r -a path_parts <<< "$path"
    IFS=/ read -r -a root_parts <<< "$root"
    i=0
    while [ "$i" -lt "${#path_parts[@]}" ] && [ "$i" -lt "${#root_parts[@]}" ] && [ "${path_parts[$i]}" = "${root_parts[$i]}" ]; do
      i=$((i + 1))
    done
    for ((j = i; j < ${#root_parts[@]}; j++)); do
      [ -n "${root_parts[$j]}" ] && rel="${rel:+$rel/}.."
    done
    for ((j = i; j < ${#path_parts[@]}; j++)); do
      [ -n "${path_parts[$j]}" ] && rel="${rel:+$rel/}${path_parts[$j]}"
    done
    printf '%s\n' "${rel:-.}"
    return 0
  fi

  printf '%s\n' "$path"
}

worktree_is_clean() {
  local path="$1" status

  status=$(git -C "$path" status --porcelain --untracked-files=all 2>/dev/null) || return 1
  [ -z "$status" ]
}

clean_usage() {
  cat >&2 <<'EOF'
Usage: wt [--clean | -c] [--force | -f] [--all | -a] [--interactive | -i] [<target>]
       wt -cf [<target>]
       wt -cfa [<target>]
EOF
}

is_clean_option_token() {
  local arg="${1:-}" flags

  case "$arg" in
    --clean|--all|--force|--interactive)
      return 0
      ;;
    -)
      return 1
      ;;
    -*)
      flags=${arg#-}
      [ -n "$flags" ] || return 1
      case "$flags" in
        *[!cfai]*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
  esac

  return 1
}

worktree_is_merged_to() {
  local path="$1" target_commit="$2" candidate_head

  candidate_head=$(git -C "$path" rev-parse --verify -q 'HEAD^{commit}' 2>/dev/null || true)
  [ -n "$candidate_head" ] || return 1
  git merge-base --is-ancestor "$candidate_head" "$target_commit" 2>/dev/null
}

worktree_is_ahead_of_upstream() {
  local path="$1" branch tracking
  # Detached or unreadable tracking state cannot qualify for upstream cleanup.
  branch=$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0
  tracking=$(git -C "$path" for-each-ref --format='%(upstream:track)' "refs/heads/$branch" 2>/dev/null) || return 0
  [[ "$tracking" == *"ahead "* ]]
}

worktree_is_merged_upstream() {
  local path="$1" prs="$2" head
  head=$(git -C "$path" rev-parse --verify -q 'HEAD^{commit}' 2>/dev/null) || return 1
  printf '%s\n' "$prs" | awk -F '\t' -v head="$head" '
    $6 == "MERGED" && $7 == head { found=1 }
    END { exit !found }
  '
}

worktree_cleanup_status() {
  # Classify current local state without fetching. Both collection and removal
  # use this policy; the caller decides whether to refresh missing PR evidence.
  local path="$1" root="$2" merged_only="$3" target_commit="$4" prs="$5" branch
  if [ "$path" = "$root" ]; then
    echo root
    return
  fi
  if ! worktree_is_clean "$path"; then
    echo dirty
    return
  fi
  if [ "$merged_only" != 1 ]; then
    echo eligible
    return
  fi
  branch=$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  if [ -n "$branch" ] && worktree_is_ahead_of_upstream "$path"; then
    echo ahead
  elif worktree_is_merged_to "$path" "$target_commit" || {
    [ -n "$branch" ] && worktree_is_merged_upstream "$path" "$prs"
  }; then
    echo eligible
  else
    echo unmerged
  fi
}

print_clean_skips() {
  if [ "${#dirty_displays[@]}" -gt 0 ]; then
    echo "Skipped unclean worktrees:"
    printf '  %s\n' "${dirty_displays[@]}"
  fi
  if [ "${#unmerged_displays[@]}" -gt 0 ]; then
    echo "Skipped clean unmerged worktrees:"
    printf '  %s\n' "${unmerged_displays[@]}"
  fi
  if [ "${#ahead_displays[@]}" -gt 0 ]; then
    echo "Skipped clean worktrees ahead of upstream:"
    printf '  %s\n' "${ahead_displays[@]}"
  fi
  if [ "${#changed_displays[@]}" -gt 0 ]; then
    echo "Skipped worktrees no longer eligible for cleanup:"
    printf '  %s\n' "${changed_displays[@]}"
  fi
}

clean_worktrees() {
  local root no_confirm=0 clean_requested=0 merged_only=1 merged_target_commit='' interactive=0
  local arg flags ch reply path display failed=0 i cleanup_target="" selected_path=""
  local cleanup_prs='' refreshed_prs=0 cleanup_status
  local -a clean_paths clean_displays dirty_displays unmerged_displays failed_displays removed_displays
  local -a ahead_displays changed_displays

  while [ "$#" -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
      --)
        if [ "$#" -ne 1 ] || [ -n "$cleanup_target" ] || [ -z "${1:-}" ]; then
          clean_usage
          return 2
        fi
        cleanup_target="$1"
        shift
        ;;
      --clean)
        clean_requested=1
        ;;
      --force)
        no_confirm=1
        ;;
      --all)
        merged_only=0
        ;;
      --interactive)
        interactive=1
        ;;
      -*)
        flags=${arg#-}
        [ -n "$flags" ] || {
          clean_usage
          return 2
        }
        case "$flags" in
          *[!cfai]*)
            clean_usage
            return 2
            ;;
        esac
        for ((i = 0; i < ${#flags}; i++)); do
          ch=${flags:i:1}
          case "$ch" in
            c) clean_requested=1 ;;
            f) no_confirm=1 ;;
            a) merged_only=0 ;;
            i) interactive=1 ;;
          esac
        done
        ;;
      *)
        if [ -n "$cleanup_target" ] || [ -z "$arg" ]; then
          clean_usage
          return 2
        fi
        cleanup_target="$arg"
        ;;
    esac
  done

  if [ "$clean_requested" != 1 ]; then
    clean_usage
    return 2
  fi
  if [ "$interactive" = 1 ] && ! command -v fzf >/dev/null 2>&1; then
    echo "Interactive cleanup requires fzf." >&2
    return 1
  fi

  root=$(find_worktrees_root) || {
    echo "Could not find .worktrees directory or Git repository root." >&2
    return 1
  }
  root=$(cd "$root" && pwd -P)
  cd "$root"

  if [ "$merged_only" = 1 ]; then
    merged_target_commit=$(git rev-parse --verify -q 'HEAD^{commit}' 2>/dev/null || true)
    if [ -z "$merged_target_commit" ]; then
      echo "Could not resolve root worktree HEAD." >&2
      return 1
    fi
  fi

  if [ -n "$cleanup_target" ]; then
    selected_path=$(resolve_path "$cleanup_target" existing) || return $?
    if [ "$selected_path" = "$root" ]; then
      echo "Cannot clean root worktree." >&2
      return 1
    fi
  fi

  if [ "$merged_only" = 1 ]; then
    cleanup_prs=$(cached_prs "$root")
  fi

  while IFS=$'\t' read -r path _; do
    [ -n "$path" ] || continue
    [ -z "$selected_path" ] || [ "$path" = "$selected_path" ] || continue
    is_existing_worktree_path "$path" || continue
    display=$(relative_path_for_root "$path" "$root")
    cleanup_status=$(worktree_cleanup_status "$path" "$root" "$merged_only" "$merged_target_commit" "$cleanup_prs")
    if [ "$cleanup_status" = unmerged ] && [ "$refreshed_prs" = 0 ] &&
      git -C "$path" symbolic-ref --quiet HEAD >/dev/null 2>&1; then
      refresh_prs 2>/dev/null || true
      cleanup_prs=$(cached_prs "$root")
      refreshed_prs=1
      cleanup_status=$(worktree_cleanup_status "$path" "$root" "$merged_only" "$merged_target_commit" "$cleanup_prs")
    fi
    case "$cleanup_status" in
      eligible)
        clean_paths+=("$path")
        clean_displays+=("$display")
        ;;
      dirty) dirty_displays+=("$display") ;;
      ahead) ahead_displays+=("$display") ;;
      unmerged) unmerged_displays+=("$display") ;;
    esac
  done < <(worktree_rows)

  if [ "${#clean_paths[@]}" -eq 0 ]; then
    if [ "$merged_only" = 1 ]; then
      echo "No clean merged non-main worktrees found."
    else
      echo "No clean non-main worktrees found."
    fi
    print_clean_skips
    return 0
  fi

  if [ "$interactive" = 1 ]; then
    pick_clean_worktrees || return $?
  fi

  if [ "$no_confirm" != 1 ]; then
    if [ "$merged_only" = 1 ]; then
      echo "Remove ${#clean_paths[@]} clean merged non-main worktree(s)?"
    else
      echo "Remove ${#clean_paths[@]} clean non-main worktree(s)?"
    fi
    printf '  %s\n' "${clean_displays[@]}"
    printf '[y/N] '
    if ! read -r reply; then
      reply=""
    fi
    case "$reply" in
      y|Y|yes|YES)
        ;;
      *)
        echo "Aborted."
        return 130
        ;;
    esac
  fi

  for i in "${!clean_paths[@]}"; do
    path=${clean_paths[$i]}
    display=${clean_displays[$i]}
    cleanup_status=$(worktree_cleanup_status "$path" "$root" "$merged_only" "$merged_target_commit" "$cleanup_prs")
    if [ "$cleanup_status" != eligible ]; then
      changed_displays+=("$display")
      continue
    fi
    if git worktree remove "$path" >&2; then
      removed_displays+=("$display")
    else
      failed=1
      failed_displays+=("$display")
    fi
  done

  if [ "${#removed_displays[@]}" -gt 0 ]; then
    echo "Removed clean worktrees:"
    printf '  %s\n' "${removed_displays[@]}"
  fi
  print_clean_skips
  if [ "${#failed_displays[@]}" -gt 0 ]; then
    echo "Failed to remove worktrees:"
    printf '  %s\n' "${failed_displays[@]}"
  fi

  return "$failed"
}

list_worktree_checks() {
  local shard="$1" shards="$2" root_head="$3" merged_heads="$4" rows="$5"
  local branch path sha state clean merged index=0
  while IFS=$'\t' read -r branch path sha state; do
    index=$((index + 1))
    [ "$(((index - 1) % shards))" -eq "$shard" ] || continue
    [ -d "$path" ] && [ -e "$path/.git" ] || continue
    clean=0
    # Only existence matters for the label: do not enumerate every file
    # inside untracked directories. Cleanup keeps its separate full check.
    [ -z "$(git -C "$path" status --porcelain --untracked-files=normal 2>/dev/null || true)" ] && clean=1
    merged=0
    if [ "$sha" = "$root_head" ]; then
      merged=1
    elif [ "$state" = detached ]; then
      git merge-base --is-ancestor "$sha" "$root_head" 2>/dev/null && merged=1
    elif [[ $'\n'"$merged_heads"$'\n' == *$'\n'"$sha"$'\n'* ]]; then
      merged=1
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$index" "$branch" "$path" "$sha" "$state" "$clean" "$merged"
  done <<< "$rows"
}

list_candidates() {
  local root root_head sort_value worktree_rows merged_heads
  local -a branch_sort_values

  root=$(find_worktrees_root) || {
    echo "Could not find .worktrees directory or Git repository root." >&2
    return 1
  }
  root=$(cd "$root" && pwd -P)

  cd "$root"
  worktree_rows=$(worktree_branch_rows --include-detached)
  root_head=$(printf '%s\n' "$worktree_rows" | awk -F '\t' -v root="$root" '$2 == root { print $3; exit }')
  # Git can classify all branch tips in one graph walk. Detached worktrees
  # have no branch ref, so they retain the individual ancestry check below.
  merged_heads=$(git for-each-ref --merged="$root_head" --format='%(objectname)' refs/heads/ 2>/dev/null || true)
  while IFS= read -r sort_value; do
    [ -n "$sort_value" ] || continue
    branch_sort_values+=("$sort_value")
  done < <(git config --get-all branch.sort 2>/dev/null || true)

  # Join the two snapshots once, rather than spawning grep for every branch
  # and scanning every worktree again for each sorted branch (O(B * W)).
  awk -F '\t' -v root_path="$root" -v sorted="${#branch_sort_values[@]}" '
    BEGIN { OFS = "\t" }
    function emit_worktree(key) {
      if (!(key in seen) && key in paths) {
        print names[key], paths[key], "worktree", labels[key], 0, shas[key], cleans[key], mergeds[key], (labels[key] == "detached" ? "" : tracking[names[key]])
        seen[key] = 1
      }
    }
    FILENAME == ARGV[1] {
      if ($2 == root_path) {
        root_branch = ($4 == "detached" ? "" : $1)
        root_sha = ($3 ~ /^0+$/ ? "" : substr($3, 1, 7))
        root_clean = $5
        if (root_branch != "") seen["b:" root_branch] = 1
        next
      }
      key = ($4 == "detached" ? "d:" : "b:") $1
      if ($4 == "detached") detached[++detached_count] = key
      if (!(key in paths)) {
        worktrees[++worktree_count] = key
        names[key] = $1; paths[key] = $2; shas[key] = substr($3, 1, 7)
        cleans[key] = $5; mergeds[key] = $6
        labels[key] = ($4 == "detached" ? "detached" : "worktree")
      }
      next
    }
    {
      branches[++branch_count] = $1
      branch_shas[branch_count] = $2
      tracking[$1] = ($3 == "" ? "[no upstream]" : $4)
      gsub(/, /, "] [", tracking[$1])
    }
    END {
      if (root_branch != "") print root_branch, root_path, "root", "root", 0, root_sha, root_clean, "", tracking[root_branch]
      else if (root_sha != "") print root_path, root_path, "root", "detached", 0, root_sha, root_clean, "", ""
      if (sorted) {
        for (i = 1; i <= branch_count; i++) emit_worktree("b:" branches[i])
        for (i = 1; i <= detached_count; i++) emit_worktree(detached[i])
      } else {
        for (i = 1; i <= worktree_count; i++) emit_worktree(worktrees[i])
      }
      for (i = 1; i <= branch_count; i++) {
        key = "b:" branches[i]
        if (!(key in seen)) {
          print branches[i], "", "branch", "branch", 1, branch_shas[i], "", "", tracking[branches[i]]
          seen[key] = 1
        }
      }
    }
  ' <(
    # Bound filesystem concurrency, then restore Git's original row order.
    # Separate pipes keep rows intact even when paths are unusually long.
    cat <(list_worktree_checks 0 8 "$root_head" "$merged_heads" "$worktree_rows") \
        <(list_worktree_checks 1 8 "$root_head" "$merged_heads" "$worktree_rows") \
        <(list_worktree_checks 2 8 "$root_head" "$merged_heads" "$worktree_rows") \
        <(list_worktree_checks 3 8 "$root_head" "$merged_heads" "$worktree_rows") \
        <(list_worktree_checks 4 8 "$root_head" "$merged_heads" "$worktree_rows") \
        <(list_worktree_checks 5 8 "$root_head" "$merged_heads" "$worktree_rows") \
        <(list_worktree_checks 6 8 "$root_head" "$merged_heads" "$worktree_rows") \
        <(list_worktree_checks 7 8 "$root_head" "$merged_heads" "$worktree_rows") |
      sort -n -k1,1 | cut -f2-
  ) <(branch_ref_rows "${branch_sort_values[@]}")
}

resolve_path() {
  local target="${1:-}"
  local existing_only="${2:-}"
  local root worktree_dir worktree_parent path branch name head kind
  local pr_branch pr_status pr_mode
  local -a matched_paths matched_labels

  if [ -z "$target" ]; then
    echo "Usage: wt __path <target>" >&2
    return 1
  fi

  root=$(find_worktrees_root) || {
    echo "Could not find .worktrees directory or Git repository root." >&2
    return 1
  }
  root=$(cd "$root" && pwd -P)

  cd "$root"

  if [ "$target" = "." ]; then
    printf '%s\n' "$root"
    return 0
  fi

  # Detached candidates use their registered absolute path as an unambiguous
  # target, even if a branch has the same name as the worktree directory.
  if [[ "$target" == /* ]]; then
    while IFS=$'\t' read -r path _; do
      [ "$path" = "$target" ] || continue
      is_existing_worktree_path "$path" || continue
      printf '%s\n' "$path"
      return 0
    done < <(worktree_rows)
    echo "No existing worktree found at '$target'." >&2
    return 1
  fi

  worktree_dir="$root/.worktrees/$target"

  path=$(worktree_path_for_branch "$target")
  if [ -n "$path" ]; then
    printf '%s\n' "$path"
    return 0
  fi

  if git show-ref --verify --quiet "refs/heads/$target"; then
    if [ "$existing_only" = existing ]; then
      echo "No worktree found for branch '$target'." >&2
      return 1
    fi
    echo "Creating worktree for branch '$target'..." >&2
    worktree_parent=$(dirname "$worktree_dir")
    mkdir -p "$worktree_parent"
    git worktree add "$worktree_dir" "$target" >&2 || return $?
    printf '%s\n' "$worktree_dir"
    return 0
  fi

  # Only fall back to substring matches after exact branch resolution.
  # Quote the target so glob characters are treated literally.
  while IFS=$'\t' read -r branch path head kind; do
    name="${path##*/}"
    [ "$kind" != detached ] || branch="$name"
    if [[ "$branch" == *"$target"* || "$name" == *"$target"* ]]; then
      is_existing_worktree_path "$path" || continue
      matched_paths+=("$path")
      matched_labels+=("$branch ($path)")
    fi
  done < <(worktree_branch_rows --include-detached)

  if [ "$existing_only" != existing ] && [ "${#matched_paths[@]}" -eq 0 ]; then
    while IFS=$'\t' read -r branch head; do
      [[ "$branch" == *"$target"* ]] || continue
      path=$(worktree_path_for_branch "$branch")
      [ -z "$path" ] || continue
      matched_paths+=("$branch")
      matched_labels+=("$branch (no worktree)")
    done < <(branch_ref_rows)
  fi

  # Use known PR aliases before substrings, but don't slow local issue-number
  # navigation with a network lookup. Cleanup remains entirely local.
  if [[ "$target" =~ ^[0-9]+$ ]] && [ "$existing_only" != existing ] && [ -z "${WT_PR_RESOLVING:-}" ]; then
    pr_mode=cached
    [ "${#matched_paths[@]}" -gt 0 ] || pr_mode=lookup
    if pr_branch=$(resolve_pr_branch "$target" "$pr_mode"); then
      WT_PR_RESOLVING=1 resolve_path "$pr_branch"
      return $?
    else
      pr_status=$?
      [ "$pr_status" -ne 2 ] || return 1
    fi
  fi

  if [ "${#matched_paths[@]}" -eq 1 ]; then
    if [[ "${matched_paths[0]}" == /* ]]; then
      printf '%s\n' "${matched_paths[0]}"
      return 0
    fi
    resolve_path "${matched_paths[0]}"
    return $?
  fi
  if [ "${#matched_paths[@]}" -gt 1 ]; then
    echo "Multiple branches or worktrees match '$target'; use a full branch name or path:" >&2
    printf '  %s\n' "${matched_labels[@]}" >&2
    return 1
  fi

  echo "Branch '$target' does not exist and no branch or worktree matches it." >&2
  return 1
}

format_rows() {
  awk -F '\t' -v with_target="${1:-0}" -v hyperlinks="${2:-0}" '
    function link_prs(text, urls,    n, links, j, url, number, label, pos, replacement) {
      if (!hyperlinks) return text
      n = split(urls, links, " ")
      for (j = 1; j <= n; j++) {
        url = links[j]
        if (url !~ /^https:\/\/[^[:space:][:cntrl:]]+\/pull\/[0-9]+$/) continue
        number = url; sub(/^.*\/pull\//, "", number)
        label = "[PR #" number "]"
        pos = index(text, label)
        if (!pos) continue
        replacement = sprintf("%c]8;;%s%c\\%s%c]8;;%c\\", 27, url, 27, label, 27, 27)
        text = substr(text, 1, pos - 1) replacement substr(text, pos + length(label))
      }
      return text
    }
    function display_path(path,    npath, nroot, path_parts, root_parts, common, i, out) {
      if (path == "") return ""
      if (root_path != "" && path == root_path) return "."
      if (root_path != "" && root_path != "/" && index(path, root_path "/") == 1) return substr(path, length(root_path) + 2)
      if (root_path == "/" && substr(path, 1, 1) == "/") return substr(path, 2)
      if (root_path != "" && substr(path, 1, 1) == "/" && substr(root_path, 1, 1) == "/") {
        npath = split(path, path_parts, "/")
        nroot = split(root_path, root_parts, "/")
        common = 1
        while (common <= npath && common <= nroot && path_parts[common] == root_parts[common]) common++
        out = ""
        for (i = common; i <= nroot; i++) if (root_parts[i] != "") out = out (out == "" ? "" : "/") ".."
        for (i = common; i <= npath; i++) if (path_parts[i] != "") out = out (out == "" ? "" : "/") path_parts[i]
        return out == "" ? "." : out
      }
      return path
    }
    {
      rows[NR] = $0
      if ($3 == "root") root_path = $2
    }
    END {
      for (i = 1; i <= NR; i++) {
        split(rows[i], f, "\t")
        shown_path[i] = display_path(f[2])
        sha_label[i] = f[6]
        targets[i] = (f[13] == "" ? f[1] : f[13])
        branch_label[i] = (f[4] == "detached" ? "(detached)" : f[1])
        status_label[i] = (f[7] == "0" ? "[dirty]" : "")
        if (f[3] == "root") status_label[i] = status_label[i] (status_label[i] == "" ? "" : " ") "[root]"
        else if (f[8] == "1") status_label[i] = status_label[i] (status_label[i] == "" ? "" : " ") "[merged]"
        else if (f[12] == "1") status_label[i] = status_label[i] (status_label[i] == "" ? "" : " ") "[merged upstream]"
        if (f[9] != "") status_label[i] = status_label[i] (status_label[i] == "" ? "" : " ") f[9]
        if (f[10] != "") status_label[i] = status_label[i] (status_label[i] == "" ? "" : " ") f[10]
        if (length(sha_label[i]) > sha_width) sha_width = length(sha_label[i])
        if (length(branch_label[i]) > branch_width) branch_width = length(branch_label[i])
        if (length(status_label[i]) > status_width) status_width = length(status_label[i])
        urls[i] = f[11]
      }
      for (i = 1; i <= NR; i++) {
        if (with_target) printf "%s\t", targets[i]
        # Pad plain text before adding zero-width terminal sequences.
        status = link_prs(sprintf("%-" status_width "s", status_label[i]), urls[i])
        if (shown_path[i] == "") {
          printf "%-" sha_width "s %-" branch_width "s %s\n", sha_label[i], branch_label[i], status
        } else {
          printf "%-" sha_width "s %-" branch_width "s %s %s\n", sha_label[i], branch_label[i], status, shown_path[i]
        }
      }
    }
  '
}

fzf_hyperlinks_enabled() {
  local version
  wt_hyperlinks_enabled || return 1
  version=$(fzf --version 2>/dev/null || true)
  [[ "$version" =~ ^([0-9]+)\.([0-9]+) ]] || return 1
  [ "${BASH_REMATCH[1]}" -gt 0 ] || [ "${BASH_REMATCH[2]}" -ge 55 ]
}

pick_clean_worktrees() {
  # clean_paths/clean_displays are the caller's eligible snapshot. The hidden
  # IDs map back to it; picker output is never interpreted as a path or command.
  local rows selection line key index i links=0 seen=$'\n'
  local -a fzf_args selected_paths selected_displays
  if fzf_hyperlinks_enabled; then
    links=1
    fzf_args+=(--ansi)
  fi
  rows=$(list_candidates | annotate_prs) || return 1
  selection=$(awk -F '\t' 'BEGIN { OFS="\t" }
    FILENAME == ARGV[1] { ids[$2]=$1; next }
    $3 == "root" { $13="_root"; print; next }
    $2 in ids { $13="clean-" ids[$2]; print }
  ' <(
    for i in "${!clean_paths[@]}"; do printf '%s\t%s\n' "$i" "${clean_paths[$i]}"; done
  ) <(printf '%s\n' "$rows") | format_rows 1 "$links" |
    awk -F '\t' '$1 != "_root"' |
    fzf "${fzf_args[@]}" --multi --cycle --height=~50% --delimiter=$'\t' --with-nth=2.. \
      --prompt='Clean worktrees> ' --info=inline \
      --header='Tab: mark | Enter: choose | Esc: cancel') || return 130
  [ -n "$selection" ] || return 130
  while IFS= read -r line; do
    key=${line%%$'\t'*}
    index=${key#clean-}
    if [[ "$key" != clean-* || ! "$index" =~ ^(0|[1-9][0-9]*)$ ]] || \
      [ "${#index}" -gt 8 ] || [ "$index" -ge "${#clean_paths[@]}" ]; then
      echo "Invalid worktree selection; nothing removed." >&2
      return 1
    fi
    [[ "$seen" != *$'\n'"$key"$'\n'* ]] || continue
    seen="$seen$key"$'\n'
    selected_paths+=("${clean_paths[$index]}")
    selected_displays+=("${clean_displays[$index]}")
  done <<< "$selection"
  clean_paths=("${selected_paths[@]}")
  clean_displays=("${selected_displays[@]}")
}

pick_candidate() {
  local rows selection branch

  rows=$(list_candidates | annotate_prs)
  if [ -z "$rows" ]; then
    echo "No worktrees or local branches found." >&2
    return 1
  fi

  if command -v fzf >/dev/null 2>&1; then
    local reload_command links=0
    local -a fzf_args
    if fzf_hyperlinks_enabled; then
      links=1
      fzf_args+=(--ansi)
    fi
    printf -v reload_command '%q __pr_fzf %s' "$WT_LIB_DIR/../wt" "$links"
    selection=$(printf '%s\n' "$rows" | format_rows 1 "$links" | fzf "${fzf_args[@]}" --height=~50% --delimiter=$'\t' --with-nth=2.. \
      --bind "load:reload-sync($reload_command)+unbind(load)") || return 130
    branch=${selection%%$'\t'*}
    [ -n "$branch" ] || return 1
    resolve_path "$branch"
  else
    printf '%s\n' "$rows" | format_rows
  fi
}

print_zsh_completion() {
  cat "$WT_LIB_DIR/hyperlinks.sh"
  cat <<'EOF'
#compdef wt

_wt() {
  local -a values labels option_values option_labels
  local -a active_values active_labels normal_values normal_labels
  local line branch worktree_path kind label sort sha clean_status merged_status status_label formatted_label display_path root_path cur wt_rows branch_label
  local REPLY
  local -a fields filtered_values filtered_labels
  local branch_width sha_width max_branch_width=0 max_sha_width=0 max_status_width=0 i
  local links=0
  wt_hyperlinks_enabled && links=1
  local -a pr_link_colors

  _wt_pr_color_code() {
    # complist wraps these values in SGR. Emit OSC between two complete SGRs,
    # so it stays in the zero-width rendering layer, outside the label text.
    REPLY=$'0m\e]8;;'"$1"$'\e\\\e[0'
    REPLY=${REPLY//\\/\\\\}
    REPLY=${REPLY//:/\\:}
  }

  _wt_link_prs() {
    local url number open close pattern='(wt-branches)=(#b)' codes found=0
    _wt_pr_color_code ''
    close=$REPLY
    codes=$close
    for url in ${=1}; do
      [[ "$url" =~ '^https://[^[:space:][:cntrl:]]+/pull/[0-9]+$' ]] || continue
      number=${url##*/}
      _wt_pr_color_code "$url"
      open=$REPLY
      pattern+="(*)(\\[PR \\#$number\\])"
      codes+="=$close=$open"
      found=1
    done
    (( found )) && pr_link_colors+=("$pattern(*)=$codes=$close")
    return 0
  }

  _wt_fuzzy_match() {
    local needle="${1:l}" haystack="${2:l}" char
    local i

    [[ -n "$needle" ]] || return 0

    for ((i = 1; i <= ${#needle}; i++)); do
      char="${needle[i]}"
      if [[ "$haystack" == *"$char"* ]]; then
        haystack="${haystack#*"$char"}"
      else
        return 1
      fi
    done

    return 0
  }

  _wt_display_path() {
    local path="$1" root="$2" rel=""
    local -a path_parts root_parts
    local i j

    if [[ -z "$path" ]]; then
      REPLY=""
      return
    fi
    if [[ -n "$root" && "$path" == "$root" ]]; then
      REPLY="."
      return
    fi
    if [[ -n "$root" && "$root" != "/" && "$path" == "$root"/* ]]; then
      REPLY="${path#$root/}"
      return
    fi
    if [[ "$root" == "/" && "$path" == /* ]]; then
      REPLY="${path#/}"
      return
    fi
    if [[ -n "$root" && "$path" == /* && "$root" == /* ]]; then
      path_parts=("${(@s:/:)path}")
      root_parts=("${(@s:/:)root}")
      i=1
      while (( i <= ${#path_parts} && i <= ${#root_parts} )) && [[ "${path_parts[i]}" == "${root_parts[i]}" ]]; do
        (( i++ ))
      done
      for ((j = i; j <= ${#root_parts}; j++)); do
        [[ -n "${root_parts[j]}" ]] && rel="${rel:+$rel/}.."
      done
      for ((j = i; j <= ${#path_parts}; j++)); do
        [[ -n "${path_parts[j]}" ]] && rel="${rel:+$rel/}${path_parts[j]}"
      done
      REPLY="${rel:-.}"
      return
    fi

    REPLY="$path"
  }

  _wt_status_label() {
    local kind="$1" clean="$2" merged="$3" tracking="$4" prs="$5" merged_upstream="$6"
    REPLY=""
    [[ "$clean" != 0 ]] || REPLY="[dirty]"
    if [[ "$kind" == root ]]; then
      REPLY="${REPLY:+$REPLY }[root]"
    elif [[ "$merged" == 1 ]]; then
      REPLY="${REPLY:+$REPLY }[merged]"
    elif [[ "$merged_upstream" == 1 ]]; then
      REPLY="${REPLY:+$REPLY }[merged upstream]"
    fi
    [[ -z "$tracking" ]] || REPLY="${REPLY:+$REPLY }$tracking"
    [[ -z "$prs" ]] || REPLY="${REPLY:+$REPLY }$prs"
    return 0
  }

  cur="${words[CURRENT]}"

  if [[ "$cur" == -* ]]; then
    option_values=(--branch --clean --all --delete --move --force --latest --help --interactive --zsh-completion -b -c -a -d -M -f -l -h -i -cf -ca -cfa -ci -cif -cia -ciaf)
    option_labels=(
      "--branch  create and switch to a new branch"
      "--clean   remove eligible merged worktrees after confirmation"
      "--all     with --clean, include every clean non-root worktree"
      "--delete  delete a branch and its worktree (clean and fully merged)"
      "--move    rename a branch and move its worktree"
      "--force   skip confirmation when used with -c/--clean"
      "--latest  switch to the latest local branch by committer date"
      "--help    show help"
      "--interactive with --clean, select worktrees with fzf multi-select"
      "--zsh-completion print the zsh completion definition"
      "-b        create and switch to a new branch"
      "-c        remove eligible merged worktrees after confirmation"
      "-a        with -c/--clean, include every clean non-root worktree"
      "-d        delete a branch and its worktree (clean and fully merged)"
      "-M        rename a branch and move its worktree"
      "-f        skip confirmation when used with -c/--clean"
      "-l        switch to the latest local branch by committer date"
      "-h        show help"
      "-i        with -c/--clean, select worktrees with fzf multi-select"
      "-cf       remove eligible merged worktrees without confirmation"
      "-ca       remove all clean non-root worktrees after confirmation"
      "-cfa      remove all clean non-root worktrees without confirmation"
      "-ci       select eligible merged worktrees to clean"
      "-cif      select eligible merged worktrees; skip confirmation"
      "-cia      select from all clean non-root worktrees"
      "-ciaf     select from all clean non-root worktrees; skip confirmation"
    )
    compadd -Q -V wt-options -d option_labels -l -- "${option_values[@]}"
    return
  fi

  if (( $+functions[_wt_pr_wait] )); then
    _wt_pr_wait
    wt_rows=$(command wt __list 2>/dev/null)
  else
    wt_rows=$(command wt __pr_list 2>/dev/null)
  fi
  if (( links )); then
    zmodload zsh/complist 2>/dev/null || links=0
    if (( links && $+functions[_setup] )); then
      _setup wt-branches
    fi
  fi

  while IFS= read -r line; do
    fields=("${(@ps:\t:)line}")
    branch="$fields[1]"
    worktree_path="$fields[2]"
    kind="$fields[3]"
    [[ -n "$branch" ]] || continue
    [[ "$kind" == "root" ]] && root_path="$worktree_path"
  done <<< "$wt_rows"

  while IFS= read -r line; do
    fields=("${(@ps:\t:)line}")
    branch="$fields[1]"
    worktree_path="$fields[2]"
    [[ -n "$branch" ]] || continue
    sha="$fields[6]"
    branch_label="$branch"
    [[ "$fields[4]" != detached ]] || branch_label="(detached)"
    sha_width=${#sha}
    branch_width=${#branch_label}
    (( sha_width > max_sha_width )) && max_sha_width=$sha_width
    (( branch_width > max_branch_width )) && max_branch_width=$branch_width
    _wt_status_label "$fields[3]" "$fields[7]" "$fields[8]" "$fields[9]" "$fields[10]" "$fields[12]"
    (( ${#REPLY} > max_status_width )) && max_status_width=${#REPLY}
  done <<< "$wt_rows"

  while IFS= read -r line; do
    fields=("${(@ps:\t:)line}")
    branch="$fields[1]"
    worktree_path="$fields[2]"
    kind="$fields[3]"
    label="$fields[4]"
    sort="$fields[5]"
    sha="$fields[6]"
    clean_status="$fields[7]"
    merged_status="$fields[8]"
    [[ -n "$branch" ]] || continue

    _wt_display_path "$worktree_path" "$root_path"
    display_path="$REPLY"
    branch_label="$branch"
    [[ "$fields[4]" != detached ]] || branch_label="(detached)"
    _wt_status_label "$kind" "$clean_status" "$merged_status" "$fields[9]" "$fields[10]" "$fields[12]"
    status_label="$REPLY"

    if [[ -z "$display_path" ]]; then
      printf -v formatted_label "%-${max_sha_width}s %-${max_branch_width}s %-${max_status_width}s" "$sha" "$branch_label" "$status_label"
    else
      printf -v formatted_label "%-${max_sha_width}s %-${max_branch_width}s %-${max_status_width}s %s" "$sha" "$branch_label" "$status_label" "$display_path"
    fi
    if (( links )); then
      _wt_link_prs "$fields[11]"
    fi

    if [[ "$sort" == 0 ]]; then
      active_values+=("$branch")
      active_labels+=("$formatted_label")
    else
      normal_values+=("$branch")
      normal_labels+=("$formatted_label")
    fi
  done <<< "$wt_rows"

  values=("${active_values[@]}" "${normal_values[@]}")
  labels=("${active_labels[@]}" "${normal_labels[@]}")
  # _main_complete publishes _comp_colors after this function returns. Scope
  # every rule to our group, retaining the user's other completion colors.
  (( ${#pr_link_colors} )) && _comp_colors=("${pr_link_colors[@]}" "${_comp_colors[@]}")

  if [[ -n "$cur" ]]; then
    for ((i = 1; i <= ${#values}; i++)); do
      if _wt_fuzzy_match "$cur" "${values[i]}" || [[ "${labels[i]}" == *"[PR #${cur}]"* ]]; then
        filtered_values+=("${values[i]}")
        filtered_labels+=("${labels[i]}")
      fi
    done

    (( ${#filtered_values} > 0 )) && compadd -U -V wt-branches -d filtered_labels -l -- "${filtered_values[@]}"
  else
    (( ${#values} > 0 )) && compadd -V wt-branches -d labels -l -- "${values[@]}"
  fi
}

compdef _wt wt
EOF
}

case "${1:-}" in
  --help|-h)
    usage
    ;;
  --zsh-completion)
    print_zsh_completion
    ;;
  __list)
    list_candidates | annotate_prs
    ;;
  __pr_refresh)
    refresh_prs
    ;;
  __pr_list)
    refresh_prs 2>/dev/null || true
    list_candidates | annotate_prs
    ;;
  __pr_fzf)
    refresh_prs 2>/dev/null || true
    list_candidates | annotate_prs | format_rows 1 "${2:-0}"
    ;;
  __latest_branch)
    latest_branch
    ;;
  __path)
    shift
    resolve_path "${1:-}"
    ;;
  --latest|-l)
    shift
    if [ "$#" -ne 0 ]; then
      latest_usage_error
      exit $?
    fi
    resolve_latest_path
    ;;
  --move|-M)
    shift
    if [ "$#" -eq 0 ] || [ "$#" -gt 2 ]; then
      branch_usage_error
      exit $?
    fi
    if [ "$#" -eq 1 ]; then
      move_branch "" "$1"
    else
      move_branch "$1" "$2"
    fi
    ;;
  --delete|-d)
    shift
    if [ "$#" -ne 1 ]; then
      branch_usage_error
      exit $?
    fi
    delete_branch "$1"
    ;;
  --branch|-b)
    shift
    if [ "$#" -ne 1 ]; then
      branch_usage_error
      exit $?
    fi
    create_branch "$1"
    ;;
  "")
    pick_candidate
    ;;
  *)
    if is_latest_mixed_short_option_token "${1:-}"; then
      latest_usage_error
      exit $?
    elif is_clean_option_token "${1:-}"; then
      clean_worktrees "$@"
    elif [[ "$1" == -* ]]; then
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
    else
      resolve_path "$1"
    fi
    ;;
esac
